# Copy to .env, choose a local password, then set DATABASE_URL accordingly.
POSTGRES_PASSWORD=
DATABASE_URL=
PORT=3001
WORKER_MODE=idle

# VMAT product authentication.
# Dedicated product login credentials; do not reuse the RR03 sandbox.
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GITHUB_CALLBACK_URL=http://127.0.0.1:5173/auth/github/callback
FRONTEND_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development

# Vercel supplies VERCEL_ENV. Do not set it locally or commit production values.
# Production must use HTTPS values on the same public origin, for example:
# AUTH_GITHUB_CALLBACK_URL=https://classroom.example.edu/auth/github/callback
# FRONTEND_ORIGIN=https://classroom.example.edu

# RR03 disposable GitHub sandbox only; secrets stay in ignored .env/.local.
GITHUB_APP_ID=4990040
GITHUB_APP_PRIVATE_KEY_PATH=.local/rr03/app.private-key.pem
GITHUB_CALLBACK_URL=http://127.0.0.1:3002/rr03/oauth/callback
GITHUB_CLIENT_ID=Iv23li5WIsPocsfDyGbK
GITHUB_CLIENT_SECRET=
GITHUB_INSTALLATION_ID=162753561
GITHUB_SANDBOX_OWNER=classroom-rr03-juan
GITHUB_SANDBOX_REPOSITORY=rr03-allowed
GITHUB_UNSELECTED_REPOSITORY=rr03-denied
GITHUB_WEBHOOK_SECRET=
