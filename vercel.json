{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web/",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "api": {
      "root": "apps/api/",
      "framework": "fastify",
      "entrypoint": "src/server.ts"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/health/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/me",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/me/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/institutions",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/auth",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/auth/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/courses",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/courses/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/activities/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/submissions/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/platform/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
